VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Generate with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-here
# PostHog analytics (EU cloud, no cookie banner needed with memory persistence)
VITE_POSTHOG_KEY=phc_PLACEHOLDER
VITE_POSTHOG_HOST=https://eu.i.posthog.com
# Stripe (publishable key + price IDs are client-safe; secret key goes into Supabase Edge Function secrets)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_PLACEHOLDER
VITE_STRIPE_PRICE_MONTHLY_CHF=price_PLACEHOLDER
VITE_STRIPE_PRICE_ANNUAL_CHF=price_PLACEHOLDER
VITE_STRIPE_PRICE_MONTHLY_EUR=price_PLACEHOLDER
VITE_STRIPE_PRICE_ANNUAL_EUR=price_PLACEHOLDER
